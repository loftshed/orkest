{
  "schema": "agent-executor.families.v2",
  "note": "A selector (`gpt:sol`, `deepseek`) names a family and a tier. A tier value that is an exact catalog ID (Claude Code aliases, OpenRouter's maintained `~vendor/...-latest` aliases) is used as is. In a family with a prefix, any other value is a keyword: among live IDs that start with the prefix and contain the keyword as whole words (separated by `-` or `/`), the highest version (`6.1`, `v4`) wins. A family without a prefix takes exact IDs only. Optional tier_strengths describe task fit without changing selector resolution. Run `run_agent.py families` to see what each selector resolves to.",
  "effort_suffixes": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"],
  "native_exclusions": ["gemma", "gpt-oss"],
  "families": {
    "gpt": {
      "engine": "codex",
      "default_for_engine": true,
      "vendor": "openai",
      "prefix": "gpt-",
      "default_tier": "sol",
      "team_selector_format": "passthrough",
      "native_providers": ["openai"],
      "native_keywords": ["gpt", "chatgpt", "codex", "astra", "sol", "terra", "luna"],
      "brand": {
        "glyph": "\uEC81",
        "tone": "brandOpenAI",
        "aliases": ["gpt", "codex", "openai", "astra", "sol", "terra", "luna"]
      },
      "tiers": { "luna": "luna", "terra": "terra", "sol": "sol", "astra": "astra" },
      "capability_tiers": { "luna": 1, "terra": 2, "sol": 3, "astra": 4 },
      "default_capability_tier": 3,
      "tier_strengths": {
        "sol": ["complex coding", "agentic workflows", "professional software work"],
        "astra": ["demanding reasoning", "complex coding", "multi-step workflows"],
        "luna": ["focused tasks", "high-volume work", "low latency", "cost efficiency"],
        "terra": ["balanced speed", "general-purpose reasoning", "cost efficiency"]
