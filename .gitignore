# Dependencies and tool state
node_modules
node_modules/
.ruff_cache/
.venv/
__pycache__/
*.py[cod]

# Output
*.log
junit.xml
artifacts/
docs/mailbox-feedback/reports/

# Local and editor files
.DS_Store
.env
.env.*
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
**/.claude/.cc-writes/
**/.claude/**/*.local.*
.codex-attachments/

# Worker checkouts: whole copies of the repository that the linters must not walk.
.worktrees/
.claude/worktrees/

# Share repository skills even when a machine-wide ignore hides .agents.
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**
