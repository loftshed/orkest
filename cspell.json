{
  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "allowCompoundWords": true,
  "dictionaries": [
    "bash",
    "css",
    "git",
    "html",
    "node",
    "npm",
    "python",
    "rust",
    "softwareTerms",
    "swift",
    "words"
  ],
  "dictionaryDefinitions": [{ "name": "words", "path": "./project-words.txt", "addWords": true }],
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    "target/**",
    "crates/**/target/**",
    "Cargo.lock",
    "crates/**/Cargo.lock",
    "project-words.txt",
    "tests/**",
    "docs/images/**",
    "plugins/orchestrate/skills/orchestrate/scripts/mailbox_store.py",
    "pnpm-lock.yaml"
  ],
  "ignoreRegExpList": [
    "/\\b[0-9a-f]{32,64}\\b/gi",
    "/\\b0x[0-9a-f_]+(?:[ui](?:8|16|32|64|128|size))?\\b/gi",
    "/https?:\\/\\/\\S+/g",
    "/\\b[A-Z0-9_]{15,}\\b/g"
  ]
}
